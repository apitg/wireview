{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WireView",
  "version": "0.1.0",
  "identifier": "com.wireview.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "WireView", "width": 1440, "height": 960, "minWidth": 920, "minHeight": 640, "resizable": true }],
    "security": { "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:" }
  },
  "bundle": {
    "active": true,
    "targets": ["appimage", "nsis"],
    "icon": []
  }
}
